<header class="border-bottom py-3">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-3">
        <% logo_path =
             if admin_signed_in?
               admin_root_path
             else
               root_path
             end %>

        <%= link_to "LOGO",
                    logo_path,
                    class: "btn btn-outline-dark px-5 py-2" %>
      </div>

      <div class="col-md-9">
        <ul class="nav justify-content-end">
          <% if admin_signed_in? %>
            <li class="nav-item">
              <%= link_to "商品一覧",
                          admin_items_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">

              <%= link_to "会員一覧",
                          admin_customers_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= link_to "ジャンル一覧",
                          admin_genres_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= button_to "ログアウト",
                            destroy_admin_session_path,
                            method: :delete,
                            class: "btn btn-outline-secondary",
                            form: { class: "d-inline" } %>
            </li>
          <% elsif customer_signed_in? %>
            <li class="nav-item">
              <%= link_to "マイページ",
                          customers_my_page_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= link_to "カート",
                          cart_items_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li> 

            <li class="nav-item">
              <%= link_to "商品一覧",
                          admin_items_path,
                          class: "btn btn-outline-secondary me-2" %>

            </li>

            <li class="nav-item">
              <%= button_to "ログアウト",
                            destroy_customer_session_path,
                            method: :delete,
                            class: "btn btn-outline-secondary",
                            form: { class: "d-inline" } %>
            </li>

          
          <% else %>
            <li class="nav-item">
              <%= link_to "About",
                          about_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= link_to "商品一覧",
                          items_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= link_to "新規登録",
                          new_customer_registration_path,
                          class: "btn btn-outline-secondary me-2" %>
            </li>

            <li class="nav-item">
              <%= link_to "ログイン",
                          new_customer_session_path,
                          class: "btn btn-outline-secondary" %>
            </li>
          <% end %>
        </ul>

        <div class="mt-3 text-end">
          <input type="text" placeholder="Search">
          <button type="button">🔍</button>
        </div>
      </div>
    </div>
  </div>
</header>
