<header class="border-bottom py-3">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-3">
        <%= link_to "LOGO",
                    root_path,
                    class: "btn btn-outline-dark px-5 py-2" %>
      </div>

      <div class="col-md-9">
        <ul class="nav justify-content-end">
          <li class="nav-item">
            <%= link_to "About",
                        about_path,
                        class: "btn btn-outline-secondary me-2" %>
          </li>

          <li class="nav-item">
            <%= link_to "商品一覧",
                        items_path,
