<div class="container py-5">
  <h1 class="h3 mb-4">管理者トップ</h1>
  <h2 class="h4 mb-3">注文履歴一覧</h2>

  <% if @orders.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>購入日時</th>
          <th>購入者</th>
          <th>注文個数</th>
          <th>注文ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td>
              <%= link_to order.created_at.strftime("%Y/%m/%d %H:%M"),
                          admin_order_path(order) %>
            </td>
            <td>
              <%= "#{order.customer.last_name} #{order.customer.first_name}" %>
            </td>
            <td><%= order.order_details.sum(&:amount) %></td>
            <td>
              <%= I18n.t("enums.order.status.#{order.status}") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>注文履歴はありません。</p>
  <% end %>
</div>
