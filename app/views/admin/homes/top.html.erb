<div class="py-4 px-lg-5">
  <h1 class="h4 d-inline-block bg-light px-4 py-2 mb-4">
    注文履歴一覧
  </h1>

  <% if @orders.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">購入日時</th>
            <th scope="col">購入者</th>
            <th scope="col">注文個数</th>
            <th scope="col">注文ステータス</th>
          </tr>
        </thead>

        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td>
                <%= link_to order.created_at.strftime("%Y/%m/%d %H:%M"),
                            admin_order_path(order),
                            class: "fw-semibold text-dark" %>
              </td>

              <td>
                <%= "#{order.customer.last_name} #{order.customer.first_name}" %>
              </td>

              <td>
                <%= order.order_details.sum(&:amount) %>
              </td>

              <td>
                <%= I18n.t("enums.order.status.#{order.status}") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-secondary">
      注文履歴はありません。
    </div>
  <% end %>
</div>
