<h2>ジャンル編集</h2>

<% if @genre.errors.any? %>
  <div>
    <h3><%= @genre.errors.count %>件のエラーが発生しました</h3>

    <ul>
      <% @genre.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @genre] do |f| %>
  <div>
    <%= f.label :name, "ジャンル名" %>
    <%= f.text_field :name %>
    <%= f.submit "変更を保存" %>
  </div>
<% end %>
