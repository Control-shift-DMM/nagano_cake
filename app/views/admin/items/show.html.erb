<h2>商品詳細</h2>

<div>
  <% if @item.image.attached? %>
    <%= image_tag @item.image, size: "250x250" %>
  <% else %>
    <%= image_tag "default-image.jpg", size: "250x250" %>
  <% end %>
</div>

<dl>
  <dt>商品名</dt>
  <dd><%= @item.name %></dd>

  <dt>商品説明</dt>
  <dd><%= simple_format(@item.introduction) %></dd>

  <dt>ジャンル</dt>
  <dd><%= @item.genre.name %></dd>

  <dt>税抜価格</dt>
  <dd><%= number_with_delimiter(@item.price) %>円</dd>

  <dt>税込価格</dt>
  <dd><%= number_with_delimiter(@item.with_tax_price) %>円</dd>

  <dt>販売ステータス</dt>
  <dd><%= @item.is_active? ? "販売中" : "販売停止中" %></dd>
</dl>

<p>
  <%= link_to "編集する", edit_admin_item_path(@item) %>
</p>

<p>
  <%= link_to "商品一覧へ戻る", admin_items_path %>
</p>
