<div class="py-4 px-lg-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 d-inline-block bg-light px-4 py-2 mb-0">
      商品一覧
    </h1>

    <%= link_to "＋",
                new_admin_item_path,
                class: "btn bg-white border rounded-circle shadow d-inline-flex align-items-center justify-content-center fs-4",
                style: "width: 48px; height: 48px;",
                aria: { label: "商品を新規登録する" } %>
  </div>

  <% if @items.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">商品ID</th>
            <th scope="col">商品名</th>
            <th scope="col">税抜価格</th>
            <th scope="col">ジャンル</th>
            <th scope="col">ステータス</th>
          </tr>
        </thead>

        <tbody>
          <% @items.each do |item| %>
            <tr>
              <td><%= item.id %></td>

              <td>
                <%= link_to item.name,
                            admin_item_path(item),
                            class: "fw-semibold text-dark" %>
              </td>

              <td>
                <%= number_with_delimiter(item.price) %>円
              </td>

              <td><%= item.genre.name %></td>

              <td>
                <% if item.is_active? %>
                  <span class="fw-semibold text-success">販売中</span>
                <% else %>
                  <span class="fw-semibold text-secondary">販売停止中</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-secondary">
      該当する商品はありません。
    </div>
  <% end %>
</div>
