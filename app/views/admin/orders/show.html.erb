<div class="row mb-5">
  <div class="col-lg-8">
    <h2 class="h5 text-dark bg-light d-inline-block px-3 py-2 mb-3">
      注文履歴詳細
    </h2>
    <table class="table table-borderless align-middle mb-0">
      <tbody>
        <tr>
          <th class="text-nowrap" style="width: 180px;">購入者</th>
          <td>
            <%= link_to "#{@order.customer.last_name} #{@order.customer.first_name}",
                        admin_customer_path(@order.customer),
                        class: "link-dark" %>
          </td>
        </tr>

        <tr>
          <th>注文日</th>
          <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
        </tr>

        <tr>
          <th>配送先</th>
          <td>
            〒<%= @order.postal_code %>
            <%= @order.address %><br>
            <%= @order.name %>
          </td>
        </tr>

        <tr>
          <th>支払方法</th>
          <td>
            <%= I18n.t("enums.order.payment_method.#{@order.payment_method}") %>
          </td>
        </tr>

        <tr>
          <th>注文ステータス</th>
          <td>
            <%= form_with model: @order,
                          url: admin_order_path(@order),
                          method: :patch,
                          local: true,
                          class: "d-flex align-items-center gap-2" do |form| %>
              <%= form.select :status,
                              options_for_select(
                                Order.statuses.keys.map { |status|
                                  [
                                    I18n.t("enums.order.status.#{status}"),
                                    status
                                  ]
                                },
                                @order.status
                              ),
                              {},
                              class: "form-select form-select-sm w-auto" %>

              <%= form.submit "更新",
                              class: "btn btn-success btn-sm px-3" %>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="row align-items-end">
  <div class="col-lg-9">
    <table class="table table-borderless align-middle mb-0">
      <thead class="table-light" style="border-top: 1px solid #000;">
        <tr>
          <th>商品名</th>
          <th class="text-center">単価（税込）</th>
          <th class="text-center">数量</th>
          <th class="text-center">小計</th>
          <th class="text-center">製作ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @order.order_details.each do |order_detail| %>
          <tr>
            <td><%= order_detail.item.name %></td>

            <td class="text-center">
              <%= number_with_delimiter(order_detail.price) %>
            </td>

            <td class="text-center">
              <%= order_detail.amount %>
            </td>

            <td class="text-center">
              <%= number_with_delimiter(
                    order_detail.price * order_detail.amount
                  ) %>
            </td>

            <td>
              <%= form_with model: order_detail,
                            url: admin_order_detail_path(order_detail),
                            method: :patch,
                            local: true,
                            class: "d-flex justify-content-center align-items-center gap-2" do |form| %>
                <%= form.select :making_status,
                                options_for_select(
                                  OrderDetail.making_statuses.keys.map { |status|
                                    [
                                      I18n.t(
                                        "enums.order_detail.making_status.#{status}"
                                      ),
                                      status
                                    ]
                                  },
                                  order_detail.making_status
                                ),
                                {},
                                class: "form-select form-select-sm w-auto" %>

                <%= form.submit "更新",
                                class: "btn btn-success btn-sm px-3" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="col-lg-3 mt-4 mt-lg-0">
    <table class="table table-borderless align-middle mb-0">
      <tbody>
        <tr>
          <th class="text-nowrap">商品合計</th>
          <td class="text-end">
            <%= number_with_delimiter(
                  @order.order_details.sum { |detail|
                    detail.price * detail.amount
                  }
                ) %>円
          </td>
        </tr>

        <tr>
          <th>送料</th>
          <td class="text-end">
            <%= number_with_delimiter(@order.shipping_cost) %>円
          </td>
        </tr>

        <tr class="fw-bold">
          <th class="text-nowrap">請求金額合計</th>
          <td class="text-end">
            <%= number_with_delimiter(@order.total_payment) %>円
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
