<div class="container py-5">
  <h1 class="h3 mb-4">注文履歴詳細</h1>

  <table class="table">
    <tbody>
      <tr>
        <th>購入者</th>
        <td>
          <%= link_to "#{@order.customer.last_name} #{@order.customer.first_name}",
                      admin_customer_path(@order.customer) %>
        </td>
      </tr>

      <tr>
        <th>注文日</th>
        <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
      </tr>

      <tr>
        <th>配送先</th>
        <td>
          〒<%= @order.postal_code %><br>
          <%= @order.address %><br>
          <%= @order.name %>
        </td>
      </tr>

      <tr>
        <th>支払方法</th>
        <td>
          <%= I18n.t("enums.order.payment_method.#{@order.payment_method}") %>
        </td>
      </tr>

      <tr>
        <th>注文ステータス</th>
        <td>
          <%= form_with model: @order,
                        url: admin_order_path(@order),
                        method: :patch,
                        local: true do |form| %>
            <%= form.select :status,
                            options_for_select(
                              Order.statuses.keys.map { |status|
                                [
                                  I18n.t("enums.order.status.#{status}"),
                                  status
                                ]
                              },
                              @order.status
                            ) %>

            <%= form.submit "更新", class: "btn btn-success" %>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="row mt-5">
    <div class="col-lg-8">
      <table class="table">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価（税込）</th>
            <th>数量</th>
            <th>小計</th>
            <th>製作ステータス</th>
          </tr>
        </thead>

        <tbody>
          <% @order.order_details.each do |order_detail| %>
            <tr>
              <td><%= order_detail.item.name %></td>
              <td>
                <%= number_with_delimiter(order_detail.price) %>円
              </td>
              <td><%= order_detail.amount %></td>
              <td>
                <%= number_with_delimiter(
                      order_detail.price * order_detail.amount
                    ) %>円
              </td>
              <td>
                <%= form_with model: order_detail,
                              url: admin_order_detail_path(order_detail),
                              method: :patch,
                              local: true do |form| %>
                  <%= form.select :making_status,
                                  options_for_select(
                                    OrderDetail.making_statuses.keys.map { |status|
                                      [
                                        I18n.t(
                                          "enums.order_detail.making_status.#{status}"
                                        ),
                                        status
                                      ]
                                    },
                                    order_detail.making_status
                                  ) %>

                  <%= form.submit "更新", class: "btn btn-success" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-lg-4">
      <table class="table">
        <tbody>
          <tr>
            <th>商品合計</th>
            <td>
              <%= number_with_delimiter(
                    @order.order_details.sum { |detail|
                      detail.price * detail.amount
                    }
                  ) %>円
            </td>
          </tr>

          <tr>
            <th>送料</th>
            <td><%= number_with_delimiter(@order.shipping_cost) %>円</td>
          </tr>

          <tr>
            <th>請求金額合計</th>
            <td><%= number_with_delimiter(@order.total_payment) %>円</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
