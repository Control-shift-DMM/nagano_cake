<div class="container mt-5">

  <!-- 見出し -->
  <div class="row mb-4">
    <div class="col-md-4">
      <h2 class="bg-light px-3 py-2 d-inline-block">
        マイページ
      </h2>
    </div>
  </div>

  <!-- 登録情報 -->
  <div class="row align-items-center mb-3">
    <div class="col-md-2">
      <h5 class="mb-0">登録情報</h5>
    </div>

    <div class="col-md-2">
      <%= link_to "編集する",
                  customers_information_edit_path,
                  class: "btn btn-success" %>
    </div>
  </div>

  <!-- 会員情報テーブル -->
  <div class="row mb-5">
    <div class="col-md-8">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th class="table-light w-25">氏名</th>
            <td><%= @customer.last_name %> <%= @customer.first_name %></td>
          </tr>
          <tr>
            <th class="table-light">カナ</th>
            <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
          </tr>
          <tr>
            <th class="table-light">郵便番号</th>
            <td><%= @customer.postal_code %></td>
          </tr>
          <tr>
            <th class="table-light">住所</th>
            <td><%= @customer.address %></td>
          </tr>
          <tr>
            <th class="table-light">電話番号</th>
            <td><%= @customer.telephone_number %></td>
          </tr>
          <tr>
            <th class="table-light">メールアドレス</th>
            <td><%= @customer.email %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 配送先 -->
  <div class="row align-items-center mb-3">
    <div class="col-md-2">
      <h5 class="mb-0">配送先</h5>
    </div>

    <div class="col-md-2">
      <%= link_to "一覧を見る",
                  addresses_path,
                  class: "btn btn-primary" %>
    </div>
  </div>

  <!-- 注文履歴 -->
  <div class="row align-items-center">
    <div class="col-md-2">
      <h5 class="mb-0">注文履歴</h5>
    </div>

    <div class="col-md-2">
      <%= link_to "一覧を見る",
                  orders_path,
                  class: "btn btn-primary" %>
    </div>
  </div>

</div>