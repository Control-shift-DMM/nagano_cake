<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h2 class="mb-4 text-secondary">配送先登録 / 一覧</h2>

      <%= form_with model: @address, url: addresses_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <div class="card mb-5 shadow-sm">
          <div class="card-body">
            <h5 class="card-title text-muted mb-4">新しい配送先を追加する</h5>
            
            <div class="row mb-3">
              <%= f.label :postal_code, "郵便番号（ハイフンなし）", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :address, "住所", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-9">
                <%= f.text_field :address, class: "form-control", placeholder: "東京都新宿区..." %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :name, "宛名", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :name, class: "form-control", placeholder: "令和太郎" %>
              </div>
              <div class="col-sm-5 text-right">
                <%= f.submit "新規登録", class: "btn btn-success px-4" %>
              </div>
            </div>

          </div>
        </div>
      <% end %>

      <table class="table table-bordered table-hover">
        <thead class="thead-light">
          <tr>
            <th style="width: 15%">郵便番号</th>
            <th style="width: 50%">住所</th>
            <th style="width: 15%">宛名</th>
            <th style="width: 20%"></th>
          </tr>
        </thead>
        <tbody>
          <% if @addresses.any? %>
            <% @addresses.each do |address| %>
              <tr>
                <td><%= address.postal_code %></td>
                <td><%= address.address %></td>
                <td><%= address.name %></td>
                <td class="text-center">
                  <%= link_to "編集する", edit_address_path(address), class: "btn btn-primary btn-sm mr-2" %>
                  <%= link_to "削除する", address_path(address), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center text-muted py-4">登録済みの配送先はありません。</td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>