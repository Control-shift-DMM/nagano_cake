<div class="container my-5">
  <div class="row">
    <div class="col-md-10 ">
      <h3 class="bg-light px-3 py-2 d-inline-block">
        配送先登録 / 一覧
      </h3>
      <%= form_with model: @address, url: addresses_path, method: :post, local: true, data: { turbo: false } do |f| %>
          <div class="card-body">            
            <div class="row mb-3">
              <%= f.label :postal_code, "郵便番号（ハイフンなし）", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :address, "住所", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-9">
                <%= f.text_field :address, class: "form-control", placeholder: "東京都渋谷区々木神園町0-0" %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :name, "宛名", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :name, class: "form-control", placeholder: "令和道子" %>
              </div>
              <div class="col-sm-5 d-flex justify-content-end">
                <%= f.submit "新規登録", class: "btn btn-success px-4" %>
              </div>
            </div>

          </div>
      <% end %>

      <table class="table table-bordered table-hover">
        <thead class="table-light">
          <tr>
            <th style="width: 15%">郵便番号</th>
            <th style="width: 45%">住所</th>
            <th style="width: 15%">宛名</th>
            <th style="width: 25%"></th>
          </tr>
        </thead>
        <tbody>
          <% if @addresses.any? %>
            <% @addresses.each do |address| %>
              <tr>
                <td><%= address.postal_code %></td>
                <td><%= address.address %></td>
                <td><%= address.name %></td>
                <td class="d-flex justify-content-center gap-2 ">
                  <%= link_to "編集する", edit_address_path(address), class: "btn btn-success btn-sm mr-2 px-3" %>
                  <%= button_to "削除する", address_path(address), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm d-inline-block px-3" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center text-muted py-4">登録済みの配送先はありません。</td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>