<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h3 class="bg-light px-3 py-2 d-inline-block">
        配送先編集
      </h3>
      <%= form_with model: @address, url: address_path(@address), method: :patch, local: true, data: { turbo: false } do |f| %>
        <div class="mb-5">
          <div class="card-body">
            
            <div class="row mb-3">
              <%= f.label :postal_code, "郵便番号（ハイフンなし）", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :postal_code, class: "form-control" %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :address, "住所", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-9">
                <%= f.text_field :address, class: "form-control" %>
              </div>
            </div>

            <div class="row mb-3">
              <%= f.label :name, "宛名", class: "col-sm-3 col-form-label font-weight-bold" %>
              <div class="col-sm-4">
                <%= f.text_field :name, class: "form-control" %>
              </div>
              <div class="col-sm-5 d-flex justify-content-end">
                <%= f.submit "変更内容を保存", class: "btn btn-success px-4" %>
              </div>
            </div>

          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>