<table> 
  <thead>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
      <th></th>
  </thead>
  <tbody>
    <%  @cart_items.each do |cart_item| %>
      <% @total_price += cart_item.item.with_tax_price * cart_item.amount %>
      <tr>
        <td>
          <% if cart_item.item.image.attached? %>
            <%= image_tag cart_item.item.image, size: "100x100" %>
          <% else %>
            <%= image_tag "no_image.jpg", size: "100x100" %>
          <% end %>
          <%= cart_item.item.name %>
        </td>
        <td><%= cart_item.item.with_tax_price %></td> # 税込み価格が入る
        <td>
          <%= cart_item.amount %>
          <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, local: true do |f| %>
            <%= f.nunber_field :amaount, in: 1..99, value: cart_item.amount %>
            <%= f.submit "変更" %>
          <% end %>
        </td> # 数量が入る
        <td><%= cart_item.item.with_tax_price*cart_item.amount%></td>
        <td>
          <%= button_to "削除する", cart_item_path(cart_item), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm d-inline-block" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<table>
  <tr>
    <td>合計金額(税込)</td>
    <td><%= @total_price %></td>
  </tr>
</table>
