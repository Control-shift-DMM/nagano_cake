<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="bg-light px-3 py-2 m-0">
    ショッピングカート
  </h3>
  <div>
    <%= button_to "カートを空にする", destroy_all_cart_items_path, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm" %>
  </div>
</div>
<table class="table table-bordered table-hover align-middle"> 
  <thead class="table-light">
    <tr>
      <th style="width: 35%">商品名</th>
      <th style="width: 10%">単価(税込)</th>
      <th style="width: 10%">数量</th>
      <th style="width: 10%">小計</th>
      <th style="width: 10%"></th>
    </tr>
  </thead>
  <tbody>
    <%  @cart_items.each do |cart_item| %>
      <% @total_price += cart_item.item.with_tax_price * cart_item.amount %>
      <tr>
        <td>
          <% if cart_item.item.image.attached? %>
            <%= image_tag cart_item.item.image, size: "50x50" %>
          <% else %>
            <%= image_tag "default-image.jpg", size: "50x50" %>
          <% end %>
          <%= cart_item.item.name %>
        </td>
        <td><%= number_with_delimiter(cart_item.item.with_tax_price) %></td> 
        <td>
          <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, local: true do |f| %>
            <%= f.select :amount, (1..10).to_a %>
            <%= f.submit "変更" %>
          <% end %>
        </td> 
        <td><%= number_with_delimiter(cart_item.item.with_tax_price*cart_item.amount) %></td>
        <td class="text-center">
          <%= button_to "削除する", cart_item_path(cart_item), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm d-inline-block" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="d-flex justify-content-between align-items-start mt-4">
  <div class="ms-5">
    <%= link_to "買い物を続ける", root_path, class: "btn btn-primary" %>
  </div>
  <table class="table table-bordered table-hover" style="width: 320px;"> 
    <tr>
      <td style="w-50 background-color: #f2f2f2 !important;">
        合計金額(税込)
      </td>
      <td class="w-50 align-middle text-end fw-bold">
        <%= number_with_delimiter(@total_price) %>
      </td>
    </tr>
  </table>
</div>

<div class="text-center">
  <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success" %>
</div>