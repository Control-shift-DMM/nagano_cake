<%= render 'error' ,order:@order %>
<%= render 'flash'%>
<h1>注文情報入力</h1>
<%= form_with model:@order ,url:confirm_orders_path do |f| %>
  <!-- 支払方法 -->
  <h5>支払方法</h5>
  <%= f.radio_button :payment_method, Order.payment_methods.key(0) %>
  <%= f.label :payment_method, Order.payment_methods_i18n[:credit_card] %>

  <%= f.radio_button :payment_method,  Order.payment_methods.key(1) %>
  <%= f.label :payment_method, Order.payment_methods_i18n[:transfer] %>

  <!-- お届け先 -->
  <h5>お届け先</h5>

  <!-- 自分の住所 -->
  <div>
    <%= f.radio_button :select_address, 0 %>
    <%= f.label :select_address_0, "ご自身の住所" %><br>

    <%= current_customer.postal_code %>
    <%= current_customer.address %><br>
    <%= current_customer.last_name %>
    <%= current_customer.first_name %>
  </div>

  <br>

  <!-- 登録済み住所 -->
  <div>
    <% if @addresses.present? %>
      <%= f.radio_button :select_address, 1 %>
      <%= f.label :select_address_1, "登録済住所から選択" %><br>

      <%= f.collection_select(
        :address_id,
        @addresses,
        :id,
        :address_display
        )
      %>
    <% else %>
      <p>登録済み住所がありません。</p>
    <% end %>

  </div>

  <br>

  <!-- 新しい住所 -->
  <div>
    <%= f.radio_button :select_address, 2 %>
    <%= f.label :select_address_2, "新しいお届け先" %>

    <table>
      <tr>
        <td>郵便番号(ハイフンなし)</td>
        <td><%= f.text_field :postal_code %></td>
      </tr>

      <tr>
        <td>住所</td>
        <td><%= f.text_field :address, size: 60 %></td>
      </tr>

      <tr>
        <td>宛名</td>
        <td><%= f.text_field :name %></td>
      </tr>
    </table>
  </div>

  <br>

  <%= f.submit "確認画面へ進む" %>


<%end%>