<h4 class="mb-4 ">注文履歴詳細</h4>
<div class="container">
  <div class="row">
    <div class="col-md-7">
      <h6 class="mb-3">注文情報</h6>
      <table class="table table-bordered custom-table align-middle">
        <tbody>
          <tr>
            <td class="table-light fw-bold">注文日</td>
            <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
          </tr>
          <tr>
            <td class="table-light fw-bold">配送先</td>
            <td>
              〒
              <%= @order.postal_code %><br>
              <%= @order.address %><br>
              <%= @order.name %>
            </td>
          </tr>
          <tr>
            <td class="table-light fw-bold">支払方法</td>
            <td><%= @order.payment_method_i18n %></td>
          </tr>
          <tr>
            <td class="table-light fw-bold">ステータス</td>
            <td><%= @order.status_i18n %></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="col-md-3">
      <h6 class="mb-3">請求情報</h6>
      <table class="table table-bordered custom-table align-middle">
        <tbody>
          <tr>
            <td class="table-light fw-bold">商品合計</td>
            <td><%= number_with_delimiter(@order.order_details.sum(&:calc_sub_total)) %></td>
          </tr>
          <tr>
            <td class="table-light fw-bold">配送料</td>
            <td>
              <%= @order.shipping_cost %>
            </td>
          </tr>
          <tr>
            <td class="table-light fw-bold">ご請求額</td>
            <td><%= number_with_delimiter(@order.total_payment) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="row mt-4">
    <div class="col-md-8">
      <h6 class="mb-3">注文内容</h6>
      <table class="table table-bordered custom-table align-middle">
        <tr class="table-light">
          <th>商品</th>
          <th>単価(税込)</th>
          <th>個数</th>
          <th>小計</th>
        </tr>
        <% @order.order_details.each do |detail| %>
          <tr>
            <td class="w-50"><%= detail.item.name %></td>
            <td class="w-25"><%= detail.price %></td>
            <td><%= detail.amount %></td>
            <td><%= detail.calc_sub_total %></td>
          </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>