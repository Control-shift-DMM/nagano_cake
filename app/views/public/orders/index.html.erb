<h4 class="mb-2">注文履歴一覧</h4>
<div class="mt-4">
  <table class="table table-hover table-bordered custom-table align-middle">
    <tr class="table-light">
      <th>注文日</th>
      <th>配送先</th>
      <th>注文商品</th>
      <th>支払金額</th>
      <th>ステータス</th>
      <th>注文詳細</th>
    </tr>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.created_at.strftime("%Y/%m/%d") %></td>
        <td>
          〒
          <%= order.postal_code %><br>
          <%= order.address %><br>
          <%= order.name %>
        </td>
        <td>
          <% order.order_details.each do |detail| %>
            <%= detail.item.name %><br>
          <% end %>
        </td>
        <td><%= number_with_delimiter(order.total_payment) %>円</td>
        <td><%= order.status_i18n %></td>
        <td class="text-center "><%= link_to "表示する" , order_path(order) ,class:"btn btn-primary fw-bold"%></td>
      </tr>
    <%end%>
  </table>
</div>