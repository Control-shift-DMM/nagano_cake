<div class="container py-5">
  <h1 class="h3 mb-4">新規会員登録</h1>

  <% if @customer.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @customer,
                url: customer_registration_path,
                local: true do |form| %>
    <div class="row mb-3">
      <div class="col-md-6">
        <%= form.label :last_name, "姓", class: "form-label" %>
        <%= form.text_field :last_name,
                            required: true,
                            class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= form.label :first_name, "名", class: "form-label" %>
        <%= form.text_field :first_name,
                            required: true,
                            class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <%= form.label :last_name_kana, "姓（カナ）", class: "form-label" %>
        <%= form.text_field :last_name_kana,
                            required: true,
                            class: "form-control" %>
      </div>

      <div class="col-md-6">
        <%= form.label :first_name_kana, "名（カナ）", class: "form-label" %>
        <%= form.text_field :first_name_kana,
                            required: true,
                            class: "form-control" %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :postal_code, "郵便番号", class: "form-label" %>
      <%= form.text_field :postal_code,
                          required: true,
                          class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :address, "住所", class: "form-label" %>
      <%= form.text_field :address,
                          required: true,
                          class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :telephone_number, "電話番号", class: "form-label" %>
      <%= form.telephone_field :telephone_number,
                               required: true,
                               class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :email, "メールアドレス", class: "form-label" %>
      <%= form.email_field :email,
                           required: true,
                           autocomplete: "email",
                           class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :password, "パスワード", class: "form-label" %>
      <%= form.password_field :password,
                              required: true,
                              autocomplete: "new-password",
                              class: "form-control" %>
    </div>

    <div class="mb-4">
      <%= form.label :password_confirmation,
                     "パスワード（確認用）",
                     class: "form-label" %>
      <%= form.password_field :password_confirmation,
                              required: true,
                              autocomplete: "new-password",
                              class: "form-control" %>
    </div>

    <%= form.submit "新規登録",
                    class: "btn btn-success px-5" %>
  <% end %>
</div>
