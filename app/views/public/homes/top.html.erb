<div class="container my-5">
  <div class="row g-4">

    <!-- ジャンル検索 -->
    <div class="col-12 col-md-3">
      <div class="border">
        <h5 class="border-bottom text-center fw-bold py-2 mb-0">
          ジャンル検索
        </h5>

        <div class="p-3">
          <% @genres.each do |genre| %>
            <div class="mb-2">
              <%= genre.name %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- メイン部分 -->
    <div class="col-12 col-md-9">

      <!-- メイン画像と説明 -->
      <div class="position-relative mb-4">
        <div class="border d-flex align-items-center justify-content-center"
             style="min-height: 280px;">
          メイン画像
        </div>

        <div class="position-absolute top-50 start-50 translate-middle bg-white border p-4">
          <p class="mb-0">
            ようこそ、ながのCAKEへ！<br>
            このサイトは、ケーキ販売のECサイトになります。<br>
            会員でない方も商品の閲覧はできますが、<br>
            購入には会員登録が必要になります。
          </p>
        </div>
      </div>

      <!-- 新着商品 -->
      <h2 class="fw-bold mb-4">
        新着商品
      </h2>

      <% if @items.any? %>
        <div class="row g-4">
          <% @items.each do |item| %>
            <div class="col-6 col-lg-3">
              <%= link_to item_path(item),
                          class: "text-decoration-none text-dark" do %>

                <div class="card h-100 border-0">
                  <% if item.image.attached? %>
                    <%= image_tag item.image,
                                  class: "card-img-top",
                                  style: "height: 160px; object-fit: cover;",
                                  alt: item.name %>
                  <% else %>
                    <%= image_tag "default-image.jpg",
                                  class: "card-img-top",
                                  style: "height: 160px; object-fit: cover;",
                                  alt: "商品画像なし" %>
                  <% end %>

                  <div class="card-body px-0">
                    <p class="card-title fw-bold mb-1">
                      <%= item.name %>
                    </p>

                    <p class="mb-0">
                      ¥<%= number_with_delimiter(item.with_tax_price) %>
                    </p>
                  </div>
                </div>

              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p>現在販売中の商品はありません。</p>
      <% end %>

      <div class="text-end mt-4">
        <%= link_to "全ての商品を見る >", items_path %>
      </div>

    </div>
  </div>
</div>