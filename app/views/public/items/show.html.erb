<div class="container my-5 public-page-layout page-left">
  <div class="row align-items-start">

    <!-- ジャンル検索 -->
    <div class="col-12 col-lg-2 genre-column">
      <div class="border genre-box">

        <div class="border-bottom text-center fw-bold py-2">
          ジャンル検索
        </div>

        <div class="p-3">
          <% if @genres.any? %>
            <% @genres.each do |genre| %>
              <div class="mb-2">
                <%= genre.name %>
              </div>
            <% end %>
          <% else %>
            <p class="mb-0 text-muted">
              ジャンルはありません
            </p>
          <% end %>
        </div>

      </div>
    </div>

    <!-- 商品画像 -->
    <div class="col-12 col-lg-4 offset-lg-1">
      <% if @item.image.attached? %>
        <%= image_tag @item.image,
                      class: "item-show-image",
                      alt: @item.name %>
      <% else %>
        <%= image_tag "default-image.jpg",
                      class: "item-show-image",
                      alt: "商品画像なし" %>
      <% end %>
    </div>

    <!-- 商品情報 -->
    <div class="col-12 col-lg-5 item-show-info">

      <h2 class="fw-bold mb-4">
        <%= @item.name %>
      </h2>

      <div class="item-description mb-5">
        <%= simple_format(@item.introduction) %>
      </div>

      <div class="mb-4">
        <span class="item-price">
          ¥<%= number_with_delimiter(@item.with_tax_price) %>
        </span>

        <span class="ms-2">
          （税込）
        </span>
      </div>

      <% if @item.is_active? %>

        <p class="text-success fw-bold mb-4">
          販売中
        </p>

        <% if customer_signed_in? %>

          <%= form_with model: @cart_item,
                        url: cart_items_path,
                        method: :post,
                        local: true do |form| %>

            <%= form.hidden_field :item_id, value: @item.id %>

            <div class="d-flex flex-wrap align-items-center gap-4">
              <%= form.select :amount,
                              options_for_select((1..10).to_a),
                              { prompt: "個数選択" },
                              class: "form-select amount-select" %>

              <%= form.submit "カートに入れる",
                              class: "btn btn-success px-4 py-2 fw-bold" %>
            </div>

          <% end %>

        <% else %>

          <div class="mt-4">
            <p class="mb-3">
              カートに商品を追加するにはログインが必要です。
            </p>

            <%= link_to "ログイン",
                        new_customer_session_path,
                        class: "btn btn-success px-4" %>
          </div>

        <% end %>

      <% else %>

        <p class="text-danger fw-bold mt-4">
          販売停止中
        </p>

      <% end %>

    </div>

  </div>
</div>