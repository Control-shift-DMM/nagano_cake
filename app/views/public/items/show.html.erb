<div class="container my-5">
  <div class="row">
    <div class="col-md-5 mb-4">
      <% if @item.image.attached? %>
        <%= image_tag @item.image,
                      class: "img-fluid w-100",
                      style: "max-height: 400px; object-fit: cover;",
                      alt: @item.name %>
      <% else %>
        <%= image_tag "default-image.jpg",
                      class: "img-fluid w-100",
                      style: "max-height: 400px; object-fit: cover;",
                      alt: "商品画像なし" %>
      <% end %>
    </div>

    <div class="col-md-7">
      <h2 class="mb-4">
        <%= @item.name %>
      </h2>

      <div class="mb-4">
        <%= simple_format(@item.introduction) %>
      </div>

      <div class="mb-4">
        <span class="fs-4 fw-bold">
          ¥<%= number_with_delimiter(@item.with_tax_price) %>
        </span>
        <span>（税込）</span>
      </div>

      <% if @item.is_active? %>
        <p class="text-success fw-bold">販売中</p>
      <% else %>
        <p class="text-danger fw-bold">販売停止中</p>
      <% end %>

      <div class="mt-4">
        <%= link_to "商品一覧へ戻る",
                    items_path,
                    class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>