<div class="container my-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex align-items-end mb-4">
        <h2 class="mb-0">商品一覧</h2>
        <span class="ms-3">
          （全<%= @items.count %>件）
        </span>
      </div>

      <% if @items.any? %>
        <div class="row">
          <% @items.each do |item| %>
            <div class="col-6 col-md-4 col-lg-3 mb-4">
              <%= link_to item_path(item),
                          class: "text-decoration-none text-dark" do %>

                <div class="card h-100 border-0">
                  <% if item.image.attached? %>
                    <%= image_tag item.image,
                                  class: "card-img-top",
                                  style: "height: 180px; object-fit: cover;",
                                  alt: item.name %>
                  <% else %>
                    <%= image_tag "default-image.jpg",
                                  class: "card-img-top",
                                  style: "height: 180px; object-fit: cover;",
                                  alt: "商品画像なし" %>
                  <% end %>

                  <div class="card-body px-0">
                    <p class="card-title mb-1">
                      <%= item.name %>
                    </p>

                    <p class="mb-0">
                      ¥<%= number_with_delimiter(item.with_tax_price) %>
                    </p>
                  </div>
                </div>

              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p>現在販売中の商品はありません。</p>
      <% end %>
    </div>
  </div>
</div>